# ==========================================
# RARY CRM — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha com suas chaves locais:
# cp .env.example .env.local
# ==========================================

# Supabase (Banco de dados e Autenticação)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# Resend (Envio de E-mails Transacionais / OTP)
# Gere a sua chave em https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Remetente Padrão
# Em testes/dev: "RARY CRM <onboarding@resend.dev>"
# Em produção: "RARY CRM <nao-responda@seudominio.com.br>"
RESEND_FROM="RARY CRM <onboarding@resend.dev>"
